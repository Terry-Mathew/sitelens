# Shared access code freelancers type to enter the app.
ACCESS_CODE=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Firecrawl API key (optional). If unset, the app falls back to direct fetch.
FIRECRAWL_API_KEY=
# Google PageSpeed Insights API key (set a daily quota cap in Google Cloud).
PAGESPEED_API_KEY=
# Upstash Redis REST URL (rate-limit counters). Required in production.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token. Required in production.
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Marketplace can create these names instead. SiteLens uses them when the two Upstash names are empty.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
