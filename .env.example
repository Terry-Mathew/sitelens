# Long random string used to sign the PageSpeed tickets (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Firecrawl API key (optional). If unset, the app falls back to direct fetch.
FIRECRAWL_API_KEY=
# Google PageSpeed Insights API key. Required in production. Set the daily quota cap in Google Cloud to 100 or more.
PAGESPEED_API_KEY=
# Upstash Redis REST URL (rate-limit counters). Required in production.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token. Required in production.
UPSTASH_REDIS_REST_TOKEN=
# The Vercel Marketplace can create these names instead. SiteLens uses them when the two Upstash names are empty.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
